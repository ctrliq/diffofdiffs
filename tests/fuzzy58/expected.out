━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 Patch 1: patch1  ┃ Patch 2: patch2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Patch mode: comparisons use only the
source lines quoted in the patches.

═════════════════════════════════════
*    DELTA DIFFERENCES              *
═════════════════════════════════════
Signs mark edits made by only that
patch. A sign-less line with one
number is an edit both patches make:
a new number means both add it, an
old number means both remove it.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│f.c      ┃ old new│f.c
        │@@       ┃        │@@
   1    │old_one  ┃   1    │old_one
+      1│new_one  ┃+      1│other_one
   2   2│p1_mid   ┃   2   2│p2_mid
   3   3│ctx_tail ┃   3   3│ctx_tail
\       │No newlin┃\       │No newlin
        │e at end ┃        │e at end
        │of file  ┃        │of file

═════════════════════════════════════
*    CONTEXT DIFFERENCES            *
═════════════════════════════════════
Signs mark lines present in only one
result: - patch1, + patch2.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     new│f.c      ┃     new│f.c
        │@@       ┃        │@@
-      1│new_one  ┃+      1│other_one
-      2│p1_mid   ┃+      2│p2_mid
       3│ctx_tail ┃       3│ctx_tail
\       │No newlin┃\       │No newlin
        │e at end ┃        │e at end
        │of file  ┃        │of file
