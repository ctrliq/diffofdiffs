━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    Patch 1: patch1     ┃    Patch 2: patch2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Patch mode: comparisons use only the source lines
quoted in the patches.

═════════════════════════════════════════════════
*    DELTA DIFFERENCES                          *
═════════════════════════════════════════════════
Signs mark edits made by only that patch. A
sign-less line with one number is an edit both
patches make: a new number means both add it, an
old number means both remove it.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│edited.txt     ┃ old new│edited.txt
        │@@ alpha       ┃        │@@ beta
   1   1│alpha          ┃        │
   2   2│beta           ┃   2   2│beta
-  3    │gamma          ┃   3   3│gamma
+      3│GAMMA          ┃        │
   4   4│delta          ┃   4   4│delta
   5   5│epsilon        ┃-  5    │epsilon
        │               ┃+      5│EPSILON

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│p1only.txt     ┃ old new│p1only.txt
        │@@ one         ┃        │@@
   1   1│one            ┃        │
-  2    │two            ┃        │
+      2│TWO            ┃        │
   3   3│three          ┃        │

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│b/created.txt  ┃ old new│b/created.txt
        │@@ newA        ┃        │@@ newA
       1│newA           ┃       1│newA
+      2│newB           ┃+      2│newB2

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
