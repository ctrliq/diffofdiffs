        │@@ r8          ┃        │@@ zzzzzzz1
        │               ┃   1   1│zzzzzzz1
        │               ┃   2   2│zzzzzzz2
        │               ┃-  3    │nonexistentline
        │               ┃+      3│REPLACEMENT
        │               ┃   4   4│zzzzzzz4
        │               ┃   5   5│zzzzzzz5
   8   8│r8             ┃        │
-  9    │r9             ┃        │
+      9│R9             ┃        │
  10  10│r10            ┃        │

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
