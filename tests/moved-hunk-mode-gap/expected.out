━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  Patch 1: patch1  ┃  Patch 2: patch2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Patch mode: comparisons use only the
source lines quoted in the patches.

═══════════════════════════════════════
*    DELTA DIFFERENCES                *
═══════════════════════════════════════
Signs mark edits made by only that
patch. A sign-less line with one number
is an edit both patches make: a new
number means both add it, an old number
means both remove it.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│src/dup.c ┃ old new│src/dup.c
        │Old mode: ┃        │
        │100644    ┃        │
        │New mode: ┃        │
        │100755    ┃        │
        │@@        ┃        │@@ void un
        │          ┃        │related(vo
        │          ┃        │id)
        │          ┃- 50    │	aaa();
        │          ┃+     50│	bbb();
