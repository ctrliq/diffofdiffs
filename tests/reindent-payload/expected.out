   3   3│{                               ┃   3   3│{
        │                                ┃   4   4│	if (ready(sp)) {
   4   4│	if (sp->on) {            ┃   5   5│		if (sp->on) {
+      5│		check(sp);       ┃+      6│			check(sp);
   5   6│		run(sp);         ┃   6   7│			run(sp);
   6   7│	}                        ┃   7   8│		}

