        │@@ lin┃        │@@
        │e1    ┃        │
   1   1│line1 ┃        │
   2   2│line2 ┃        │
   3   3│line3 ┃        │
-  4    │line4 ┃        │
+      4│line4X┃        │
   5   5│line5 ┃        │
   6   6│line6 ┃        │
   7   7│line7 ┃        │

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
