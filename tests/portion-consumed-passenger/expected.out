        │@@                        ┃        │@@ int fx(void)
        │                          ┃   1   1│	y0
        │                          ┃   2   2│	y1
        │                          ┃   3   3│	y2
        │                          ┃+      4│	struct params *sp;
        │                          ┃   4   5│	y3
        │                          ┃   5   6│	y4
        │                          ┃   6   7│	y5

