━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 Patch 1: patch1 ┃ Patch 2: patch2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Patch mode: comparisons use only
the source lines quoted in the
patches.

═══════════════════════════════════
*    DELTA DIFFERENCES            *
═══════════════════════════════════
Signs mark edits made by only that
patch. A sign-less line with one
number is an edit both patches
make: a new number means both add
it, an old number means both remove
it.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│f       ┃ old new│f
        │@@ start┃        │@@ start
   1   1│start   ┃   1   1│start
   2    │old1    ┃   2    │old1
-  3    │extra   ┃        │
   4    │old2    ┃   3    │old2
        │────────╂────────┼────────
        │@@ share┃        │@@ share
        │d1      ┃        │d1
       2│shared1 ┃       3│shared1
+      3│p1_extra┃        │
       4│shared2 ┃       4│shared2
   5   5│        ┃        │
   6    │old3    ┃        │

═══════════════════════════════════
*    CONTEXT DIFFERENCES          *
═══════════════════════════════════
Signs mark lines present in only
one result: - patch1, + patch2.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     new│f       ┃     new│f
        │@@ start┃        │@@ start
       1│start   ┃       1│start
        │        ┃+      2│
       2│shared1 ┃       3│shared1
-      3│p1_extra┃        │
       4│shared2 ┃       4│shared2
-      5│        ┃        │
       6│tail    ┃       5│tail
       7│end     ┃       6│end
