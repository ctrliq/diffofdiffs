━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 Patch 1: patch1  ┃ Patch 2: patch2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Patch mode: comparisons use only the
source lines quoted in the patches.

═════════════════════════════════════
*    DELTA DIFFERENCES              *
═════════════════════════════════════
Signs mark edits made by only that
patch. A sign-less line with one
number is an edit both patches make:
a new number means both add it, an
old number means both remove it.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│f.c      ┃ old new│f.c
        │@@       ┃        │@@
  10  10│ctx_a    ┃  10  10│ctx_a
  11  11│ctx_b    ┃  11  11│ctx_b
  12    │old_one  ┃  12    │old_one
+     12│new_one  ┃+     12│other_one
  13  13│ctx_c    ┃  13  13│ctx_c
  14  14│p1_only  ┃  14  14│p2_only
  15  15│ctx_d    ┃  15  15│ctx_d

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 old new│k.c      ┃ old new│k.c
        │@@       ┃        │@@
  10  10│k_a      ┃  10  10│k_a
  11    │k_old    ┃  11    │k_old
+     11│k_new    ┃+     11│k_other
  12  12│k_b      ┃  12  12│k_b
  13  13│k_p1_only┃  13  13│k_p2_only
  14  14│k_c      ┃  14  14│k_c

═════════════════════════════════════
*    CONTEXT DIFFERENCES            *
═════════════════════════════════════
Signs mark lines present in only one
result: - patch1, + patch2.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     new│f.c      ┃     new│f.c
        │@@       ┃        │@@
      11│ctx_b    ┃      11│ctx_b
-     12│new_one  ┃+     12│other_one
      13│ctx_c    ┃      13│ctx_c
-     14│p1_only  ┃+     14│p2_only
      15│ctx_d    ┃      15│ctx_d
      16│ctx_tail ┃      16│ctx_tail
\       │No newlin┃\       │No newlin
        │e at end ┃        │e at end
        │of file  ┃        │of file

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     new│k.c      ┃     new│k.c
        │@@       ┃        │@@
      10│k_a      ┃      10│k_a
-     11│k_new    ┃+     11│k_other
      12│k_b      ┃      12│k_b
-     13│k_p1_only┃+     13│k_p2_only
      14│k_c      ┃      14│k_c
